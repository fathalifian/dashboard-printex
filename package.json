  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs src/lib/*.test.mjs",
    "typecheck": "tsc --noEmit",
